{
  "installCommand": "npm install --ignore-scripts && npm rebuild argon2 && npm install --prefix market",
  "buildCommand": "npm run build --prefix market",
  "outputDirectory": "market/dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "sql/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/coinbase-api/:path*",
      "destination": "https://api.coinbase.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api$|api/|coinbase-api/).*)",
      "destination": "/index.html"
    }
  ]
}
