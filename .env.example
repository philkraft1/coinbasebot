# Neon Postgres (local only). Copy to .env — never commit the real URLs.
# DATABASE_URL — pooled wallet_app (runtime: run-awal, npm run events)
# DATABASE_URL_UNPOOLED — direct neondb_owner (npm run db:migrate only)
# DATABASE_URL=postgresql://wallet_app:PASSWORD@HOST-pooler/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@HOST/neondb?sslmode=require

# Coinbase Advanced Trade WebSocket (CDP API key)
# Required for `user` and `futures_balance_summary`. Optional on public channels.
# Never commit the real values. A fresh JWT is minted per subscribe (2 minute expiry).
# https://docs.cdp.coinbase.com/coinbase-app/advanced-trade-apis/websocket/websocket-authentication

COINBASE_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nYOUR PRIVATE KEY\n-----END EC PRIVATE KEY-----\n"

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Data API (PostgREST). JWT required for table queries.
# NEON_DATA_API_URL=https://ep-xxx.apirest.c-4.us-east-2.aws.neon.tech/neondb/rest/v1
NEON_DATA_API_URL=

# Username accounts + saved chart prefs. Separate from Neon DATABASE_URL.
# Production: encrypted AWS RDS (infra/auth-rds.yaml). Use auth_app, sslmode=verify-full.
# AUTH_DATABASE_URL=postgresql://auth_app:PASSWORD@xxx.rds.amazonaws.com:5432/coinbasebot_auth?sslmode=verify-full
# AUTH_DATABASE_URL_OWNER=postgresql://cbadmin:PASSWORD@xxx.rds.amazonaws.com:5432/coinbasebot_auth?sslmode=verify-full
# AUTH_DATABASE_SSL_CA=/path/to/global-bundle.pem
# Omit AUTH_DATABASE_URL for local/dev — the API uses on-disk PGlite under .data/auth.
AUTH_DATABASE_URL=
AUTH_DATABASE_URL_OWNER=
AUTH_SESSION_SECRET=
AWS_REGION=us-east-1
AUTH_PORT=43148

